#!/usr/bin/env python3
"""
ESM Record Availability Checker - Simple Standalone Version

Description:
    This script checks the availability of pre-selected ESM records by sending 
    authenticated HEAD/POST requests to the ESM eventdata service. It reads a 
    CSV file containing event_id and station_code pairs, queries the ESM API 
    for each record, and creates a new CSV file containing only the records 
    that are publicly available. A detailed log of unavailable records is also 
    generated for transparency.
"""

# --- Standard Library Imports ---
import csv
import time
import sys
import os
from datetime import datetime

# --- Third-Party Imports ---
import requests
from requests.adapters import HTTPAdapter
from urllib3.util.retry import Retry


# ====================== (YOUR EXACT CODE STARTS HERE) ======================

def create_session():
    """Create and configure a requests session with retry strategy."""
    session = requests.Session()
    
    # Define retry strategy for transient errors
    retry_strategy = Retry(
        total=3,  # Retry up to 3 times
        backoff_factor=0.5,  # Wait 0.5, 1.0, 2.0 seconds between retries
        status_forcelist=[429, 500, 502, 503, 504],  # Retry on these status codes
        allowed_methods=["HEAD", "GET", "POST"]  # Safe methods to retry
    )
    
    # Mount the retry adapter for both HTTP and HTTPS
    adapter = HTTPAdapter(max_retries=retry_strategy)
    session.mount("http://", adapter)
    session.mount("https://", adapter)
    
    return session

def check_record_availability(session, event_id, station_code, token_content):
    """
    Check if a specific record is available via authenticated request.
    
    Returns:
        tuple: (is_available: bool, status_code: int, message: str)
    """
    try:
        # ESM eventdata service URL
        url = "https://esm-db.eu/esmws/eventdata/1/query"
        
        # Build the query parameters
        params = {
            'eventid': event_id,
            'station': station_code,
            'format': 'ascii'
        }
        
        # Send authenticated request (POST with token)
        response = session.post(
            url,
            params=params,
            files={'message': ('token.txt', token_content, 'application/octet-stream')},
            timeout=15,
            allow_redirects=True
        )
        
        # Check the response
        if response.status_code == 200:
            return True, response.status_code, "Available"
        elif response.status_code == 403:
            return False, response.status_code, "Forbidden - Not publicly available"
        elif response.status_code == 404:
            return False, response.status_code, "Not found"
        elif response.status_code == 429:
            return False, response.status_code, "Rate limited"
        else:
            return False, response.status_code, f"Unexpected status: {response.status_code}"
            
    except requests.exceptions.Timeout:
        return False, 0, "Request timeout"
    except requests.exceptions.ConnectionError:
        return False, 0, "Connection error"
    except Exception as e:
        return False, 0, f"Error: {str(e)}"

def get_file_path(prompt, default=None):
    """Prompt user for a file path with validation."""
    while True:
        if default:
            user_input = input(f"{prompt} [{default}]: ").strip()
            if not user_input:
                user_input = default
        else:
            user_input = input(f"{prompt}: ").strip()
        
        # Check if file exists
        if os.path.exists(user_input):
            return user_input
        else:
            print(f" File not found: {user_input}")
            print("Please enter a valid file path.")

def show_progress(current, total, start_time):
    """Show a simple text-based progress bar."""
    percent = (current / total) * 100
    elapsed = time.time() - start_time
    if current > 0:
        estimated_total = (elapsed / current) * total
        eta = estimated_total - elapsed
        eta_str = f"ETA: {eta:.0f}s"
    else:
        eta_str = ""
    
    bar_length = 30
    filled_length = int(bar_length * current // total)
    bar = '█' * filled_length + '░' * (bar_length - filled_length)
    
    sys.stdout.write(f"\r[{bar}] {percent:.1f}% ({current}/{total}) {eta_str}")
    sys.stdout.flush()

def main():
    """Main interactive function."""
    print("\n" + "="*60)
    print("ESM RECORD AVAILABILITY CHECKER")
    print("="*60)
    
    # Get file paths interactively
    print("\n Please provide the required file paths:")
    
    # Get input CSV file
    input_csv = get_file_path("1. Path to your filtered CSV file")
    
    # Get token file
    token_file = get_file_path("2. Path to your ESM token file")
    
    # Set default output names based on input
    base_name = os.path.splitext(input_csv)[0]
    default_output = f"{base_name}_available.csv"
    default_log = f"{base_name}_availability.log"
    
    # Get output file names
    output_csv = input(f"\n3. Output CSV file name [{default_output}]: ").strip()
    if not output_csv:
        output_csv = default_output
    
    log_file = input(f"4. Log file name [{default_log}]: ").strip()
    if not log_file:
        log_file = default_log
    
    # Ask for delay between requests
    delay_input = input("\n5. Delay between requests in seconds [0.2]: ").strip()
    if delay_input:
        try:
            request_delay = float(delay_input)
        except ValueError:
            print("Invalid number, using default 0.2 seconds")
            request_delay = 0.2
    else:
        request_delay = 0.2
    
    print(f"\n⚙️  Configuration:")
    print(f"   Input CSV: {input_csv}")
    print(f"   Token file: {token_file}")
    print(f"   Output CSV: {output_csv}")
    print(f"   Log file: {log_file}")
    print(f"   Request delay: {request_delay} seconds")
    
    # Confirm before proceeding
    confirm = input("\nProceed with availability check? (y/n): ").strip().lower()
    if confirm != 'y':
        print("Operation cancelled.")
        return
    
    # Read the token file
    print(f"\n Reading token from: {token_file}")
    try:
        with open(token_file, 'rb') as f:
            token_content = f.read()
        print(" Token loaded successfully")
    except Exception as e:
        print(f" ERROR: Could not read token file: {e}")
        return
    
    # Load the CSV file
    print(f"\n Loading data from: {input_csv}")
    try:
        # Read the CSV file
        records = []
        with open(input_csv, 'r', encoding='utf-8') as f:
            csv_reader = csv.DictReader(f)
            fieldnames = csv_reader.fieldnames
            
            # Store all records
            for row in csv_reader:
                records.append(row)
        
        total_records = len(records)
        print(f" Loaded {total_records:,} records")
        
        if total_records == 0:
            print(" ERROR: No records found in CSV file")
            return
            
        # Check if required columns exist
        if 'event_id' not in fieldnames or 'station_code' not in fieldnames:
            print(" ERROR: CSV must contain 'event_id' and 'station_code' columns")
            print(f"Available columns: {', '.join(fieldnames)}")
            return
            
    except Exception as e:
        print(f" ERROR: Could not read CSV file: {e}")
        return
    
    # Initialize tracking
    available_records = []
    unavailable_list = []
    
    # Create session
    session = create_session()
    
    # Start processing
    print(f"\n Starting availability checks...")
    print(f"   Using endpoint: https://esm-db.eu/esmws/eventdata/1/query")
    print("-" * 60)
    
    start_time = time.time()
    
    # Process each record
    for i, record in enumerate(records):
        event_id = str(record['event_id'])
        station_code = str(record['station_code'])
        
        # Show progress
        show_progress(i + 1, total_records, start_time)
        
        # Check availability
        is_available, status_code, message = check_record_availability(
            session, event_id, station_code, token_content
        )
        
        # Record result
        if is_available:
            available_records.append(record)
        else:
            unavailable_list.append({
                'index': i,
                'event_id': event_id,
                'station_code': station_code,
                'status_code': status_code,
                'message': message
            })
        
        # Be polite to the server
        time.sleep(request_delay)
    
    # Close the session
    session.close()
    
    # Print final progress (100%)
    show_progress(total_records, total_records, start_time)
    print()  # New line after progress bar
    
    # Save available records to new CSV
    print(f"\n Saving available records to: {output_csv}")
    try:
        with open(output_csv, 'w', newline='', encoding='utf-8') as f:
            if available_records:
                writer = csv.DictWriter(f, fieldnames=fieldnames)
                writer.writeheader()
                writer.writerows(available_records)
                print(f" Saved {len(available_records):,} available records")
            else:
                print("  No available records to save")
    except Exception as e:
        print(f" ERROR: Could not save output CSV: {e}")
    
    # Save detailed log file
    print(f"\n Saving log file to: {log_file}")
    try:
        with open(log_file, 'w', encoding='utf-8') as f:
            f.write(f"ESM Availability Check Log\n")
            f.write(f"Generated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")
            f.write(f"Input file: {input_csv}\n")
            f.write(f"Total records checked: {total_records}\n")
            f.write(f"Available records: {len(available_records)}\n")
            f.write(f"Unavailable records: {len(unavailable_list)}\n")
            f.write("-" * 80 + "\n\n")
            
            if unavailable_list:
                f.write("UNAVAILABLE RECORDS:\n")
                f.write("Index,Event_ID,Station_Code,Status_Code,Message\n")  # <- Fixed typo here
                for item in unavailable_list:
                    f.write(f"{item['index']},{item['event_id']},{item['station_code']},{item['status_code']},{item['message']}\n")
            else:
                f.write("All records were available!\n")
        
        print(" Log file saved successfully")
    except Exception as e:
        print(f" ERROR: Could not save log file: {e}")
    
    # Calculate statistics
    total_time = time.time() - start_time
    available_count = len(available_records)
    unavailable_count = len(unavailable_list)
    
    # Print summary
    print("\n" + "="*60)
    print("AVAILABILITY CHECK COMPLETE - SUMMARY")
    print("="*60)
    print(f"Total processing time: {total_time:.1f} seconds")
    print(f"Total records checked: {total_records:,}")
    print(f" Available records: {available_count:,}", end="")
    if total_records > 0:
        print(f" ({available_count/total_records*100:.1f}%)")
    else:
        print()
    
    print(f"Unavailable records: {unavailable_count:,}", end="")
    if total_records > 0:
        print(f" ({unavailable_count/total_records*100:.1f}%)")
    else:
        print()
    
    # Show some unavailable records if any
    if unavailable_list:
        print(f"\nFirst 5 unavailable records:")
        for i, item in enumerate(unavailable_list[:5]):
            print(f"  {i+1}. {item['event_id']} / {item['station_code']}: {item['message']}")
    
    print(f"\n Output files created:")
    print(f"   • Available records: {output_csv}")
    print(f"   • Detailed log: {log_file}")
    
    # Final message
    if available_count == 0:
        print("\n  WARNING: No available records were found!")
        print("   You may need to broaden your selection criteria.")
    elif available_count < total_records * 0.5:
        print(f"\n  Note: Less than 50% of records are available.")
        print("   Consider if this is sufficient for your research.")

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\n  Operation cancelled by user.")
    except Exception as e:
        print(f"\n Unexpected error: {e}")
    finally:
        input("\nPress Enter to exit...")
