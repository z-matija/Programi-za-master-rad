"""
Seismic Intensity Measure Calculator & Report Generator

Description:
    This script processes earthquake time history and response spectra data to
    calculate multiple seismic intensity measures and generates comprehensive
    reports. It reads paired time history and response spectra files from two
    input folders, calculates 12 different intensity measures (PGA, PGV, RMS,
    Arias Intensity, CAV, Sa(T1), Sv(T1), average spectral acceleration, VSI,
    Housner Intensity, ASI, Cordova IM), and outputs both a machine-readable
    text file and a formatted HTML report. Results are sorted numerically by
    filename (nC format).
"""

# --- Standard Library Imports ---
import os
import glob
import math
import sys
import re
from collections import OrderedDict

# --- Third-Party Imports ---
import numpy as np
import pandas as pd


