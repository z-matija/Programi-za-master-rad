def create_sweep_heatmaps(df_wall, wall_name, im_type, output_dir):
    p1_vals = sorted(df_wall['p1'].unique())
    p2_vals = sorted(df_wall['p2'].unique())
    r2_mat = np.full((len(p1_vals), len(p2_vals)), np.nan)
    sigma_mat = np.full((len(p1_vals), len(p2_vals)), np.nan)
    for _, row in df_wall.iterrows():
        i = p1_vals.index(row['p1'])
        j = p2_vals.index(row['p2'])
        r2_mat[i, j] = row['r2_log']
        sigma_mat[i, j] = row['sigma']
    if im_type in ['Cordova', 'INp']:
        row_labels = [f"c={v:.1f}" for v in p1_vals]
        col_labels = [f"α={v:.2f}" for v in p2_vals]
        xlabel = 'α'
        ylabel = 'c'
    elif im_type == 'ISa':
        row_labels = [f"α={v:.2f}" for v in p1_vals]
        col_labels = [f"β={v:.2f}" for v in p2_vals]
        xlabel = 'β'
        ylabel = 'α'
    else:  # AvgSa
        row_labels = [f"a={v:.2f}" for v in p1_vals]
        col_labels = [f"b={v:.2f}" for v in p2_vals]
        xlabel = 'b'
        ylabel = 'a'
    safe_wall = "".join(c for c in wall_name if c.isalnum() or c in (' ', '_')).rstrip()
    create_heatmap(r2_mat, row_labels, col_labels,
                   title=f"{wall_name} - {im_type} R²",
                   filename=os.path.join(output_dir, f"{safe_wall}_{im_type}_R2_heatmap.png"),
                   xlabel=xlabel, ylabel=ylabel,
                   vmin=0, vmax=1, cmap='RdYlGn', annot=True, fmt='.3f')
    create_heatmap(sigma_mat, row_labels, col_labels,
                   title=f"{wall_name} - {im_type} Disperzija σ",
                   filename=os.path.join(output_dir, f"{safe_wall}_{im_type}_sigma_heatmap.png"),
                   xlabel=xlabel, ylabel=ylabel,
                   vmin=0, vmax=1, cmap='RdYlGn_r', annot=True, fmt='.3f')

