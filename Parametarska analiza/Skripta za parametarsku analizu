def create_heatmap(data_matrix, row_labels, col_labels, title, filename,
                   xlabel='Parameter b (or second parameter)',
                   ylabel='Parameter a (or first parameter)',
                   vmin=None, vmax=None, cmap='RdYlGn', annot=True, fmt='.3f'):
    if data_matrix.size == 0:
        print(f"  Warning: No data for heatmap {title}")
        return
    n_rows, n_cols = data_matrix.shape
    cell_size = 0.8
    fig_width = max(10, n_cols * cell_size + 2)
    fig_height = max(8, n_rows * cell_size + 1.5)
    plt.figure(figsize=(fig_width, fig_height))
    mask = np.isnan(data_matrix)
    ax = sns.heatmap(data_matrix, annot=annot, fmt=fmt, cmap=cmap, mask=mask,
                     vmin=vmin, vmax=vmax, linewidths=2, linecolor='white',
                     square=True, cbar_kws={'label': title, 'shrink': 0.8},
                     annot_kws={'size': 10, 'weight': 'bold', 'color': 'black', 'family': 'Times New Roman'})
    ax.set_xlabel(xlabel, fontsize=13, fontweight='bold', fontfamily='Times New Roman')
    ax.set_ylabel(ylabel, fontsize=13, fontweight='bold', fontfamily='Times New Roman')
    ax.set_title(title, fontsize=15, fontweight='bold', pad=20, fontfamily='Times New Roman')
    ax.set_xticks(np.arange(len(col_labels)) + 0.5)
    ax.set_xticklabels(col_labels, rotation=45, ha='right', fontsize=10, fontfamily='Times New Roman')
    ax.set_yticks(np.arange(len(row_labels)) + 0.5)
    ax.set_yticklabels(row_labels, fontsize=10, rotation=0, fontfamily='Times New Roman')
    for _, spine in ax.spines.items():
        spine.set_visible(True)
        spine.set_linewidth(3)
        spine.set_color('white')
    ax.grid(False)
    plt.tight_layout()
    plt.savefig(filename, dpi=300, bbox_inches='tight', facecolor='white')
    plt.close()
    print(f"  Heatmap saved: {filename}")

