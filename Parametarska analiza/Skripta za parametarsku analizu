CONFIG_FILENAME = "unified_powerlaw_config.json"

def get_config_dir():
    try:
        return os.path.dirname(os.path.abspath(__file__))
    except NameError:
        return os.getcwd()

def get_config_path():
    return os.path.join(get_config_dir(), CONFIG_FILENAME)

def save_config(config):
    config_path = get_config_path()
    save_copy = {
        'mode': config['mode'],
        'main_folder': config['main_folder'],
        'disp_folder': config['disp_folder'],
        'num_walls': config['num_walls'],
        'drift_limit': config['drift_limit'],
        'reference_drift_limit': config['reference_drift_limit'],
        'y_type': config['y_type'],
        'height': config.get('height', 1.0),          # common height for y_type=1
        'use_log_y': config['use_log_y'],
        'use_log_x': config['use_log_x'],
        'wall_columns': config.get('wall_columns', {}),
        'wall_heights': config.get('wall_heights', {})  # per‑wall heights for y_type=3
    }
    if config['mode'] == 'selective':
        save_copy['selected_ims'] = config.get('selected_ims', [])
    else:
        save_copy['sweep_im'] = 'all'
    with open(config_path, 'w') as f:
        json.dump(save_copy, f, indent=2)
    print(f"Configuration saved to {config_path}")

def load_config():
    config_path = get_config_path()
    if not os.path.exists(config_path):
        return None
    try:
        with open(config_path, 'r') as f:
            saved = json.load(f)
        required = ['mode', 'main_folder', 'disp_folder', 'num_walls', 'drift_limit',
                    'reference_drift_limit', 'y_type', 'use_log_y', 'use_log_x']
        if all(k in saved for k in required):
            if 'wall_heights' not in saved:
                saved['wall_heights'] = {}
            return saved
        else:
            print("Config file missing required fields. Ignoring.")
            return None
    except Exception as e:
        print(f"Error loading config: {e}. Ignoring.")
        return None

def confirm_section(section_name, current_value, display_func=None):
