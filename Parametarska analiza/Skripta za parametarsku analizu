def create_individual_plot(display_name, im_label, X_valid, Y_valid, a, b, r2_log, r2_orig, sigma,
                           total_count, filtered_count, drift_limit_percent, reference_drift_limit,
                           use_log_x, use_log_y, wall_marker, output_dir, y_label):
    plt.figure(figsize=(14, 10))
    plt.scatter(X_valid, Y_valid, marker=wall_marker, color=COLOR, alpha=0.7, s=30)
    x_plot = np.linspace(X_valid.min(), X_valid.max(), 300)
    y_plot = a * (x_plot ** b)
    plt.plot(x_plot, y_plot, color=COLOR, linestyle='-', linewidth=1.5,
             label=f'y = {a:.4f} x^{b:.3f}')
    if use_log_y:
        plt.yscale('log')
    if use_log_x:
        plt.xscale('log')
    plt.ylim(top=np.max(Y_valid) * 1.05)
    plt.xlabel(im_label, fontfamily='Times New Roman', fontsize=18)
    plt.ylabel(y_label, fontfamily='Times New Roman', fontsize=18)
    plt.title(f'{display_name} - {im_label}', fontfamily='Times New Roman', fontsize=18)
    ann_text = (f'$a = {a:.4f}$, $b = {b:.3f}$\n'
                f'$R^2_{{log}} = {r2_log:.3f}$, $R^2_{{orig}} = {r2_orig:.3f}$\n'
                f'$\\sigma = {sigma:.3f}$, $e^{{\\sigma}} = {np.exp(sigma):.3f}$\n')
    plt.text(0.02, 0.98, ann_text, transform=plt.gca().transAxes,
             fontsize=18, verticalalignment='top', fontfamily='Times New Roman',
             bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))
    plt.legend(loc='best', prop={'family': 'Times New Roman', 'size': 18})
    plt.grid(True, alpha=0.3)
    safe_wall = "".join(c for c in display_name if c.isalnum() or c in (' ', '_')).rstrip()
    safe_im = "".join(c for c in im_label if c.isalnum() or c in (' ', '_', '=', '(', ')')).rstrip()
    scale_suffix = ""
    if use_log_x and use_log_y:
        scale_suffix = "_log_log"
    elif use_log_x:
        scale_suffix = "_log_x"
    elif use_log_y:
        scale_suffix = "_log_y"
    filename = os.path.join(output_dir, f"{safe_wall}_{safe_im}_powerlaw{scale_suffix}.png")
    plt.savefig(filename, dpi=300, bbox_inches='tight')
    plt.close()

def create_diagnostic_plots_and_csv(display_name, im_label, residuals_log, fitted_log, output_dir):
    diag_dir = os.path.join(output_dir, "diagnostics")
    os.makedirs(diag_dir, exist_ok=True)
    safe_wall = "".join(c for c in display_name if c.isalnum() or c in (' ', '_')).rstrip()
    safe_im = "".join(c for c in im_label if c.isalnum() or c in (' ', '_', '=', '(', ')')).rstrip()
    base_name = f"{safe_wall}_{safe_im}"

    plt.figure(figsize=(8, 6))
    plt.scatter(fitted_log, residuals_log, alpha=0.7, color='black')
    plt.axhline(y=0, color='red', linestyle='--', linewidth=1.5)
    plt.xlabel('Fitted values (log scale)', fontfamily='Times New Roman')
    plt.ylabel('Residuals', fontfamily='Times New Roman')
    plt.title(f'{display_name} - {im_label}\nResiduals vs Fitted', fontfamily='Times New Roman')
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.savefig(os.path.join(diag_dir, f"{base_name}_residuals_vs_fitted.png"), dpi=300, bbox_inches='tight')
    plt.close()

    plt.figure(figsize=(8, 6))
    stats.probplot(residuals_log, dist="norm", plot=plt)
    plt.title(f'{display_name} - {im_label}\nNormal Q-Q Plot', fontfamily='Times New Roman')
    plt.xlabel('Theoretical Quantiles', fontfamily='Times New Roman')
    plt.ylabel('Sample Quantiles', fontfamily='Times New Roman')
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.savefig(os.path.join(diag_dir, f"{base_name}_qq_plot.png"), dpi=300, bbox_inches='tight')
    plt.close()

    df_diag = pd.DataFrame({'fitted_log': fitted_log, 'residuals_log': residuals_log})
    csv_path = os.path.join(diag_dir, f"{base_name}_diagnostics.csv")
    df_diag.to_csv(csv_path, index=False)
    print(f"  Diagnostics saved to {diag_dir} for {display_name} - {im_label}")

