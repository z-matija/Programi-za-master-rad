def get_float_input(prompt, default_value=None):
    while True:
        user_input = input(prompt).strip()
        if not user_input and default_value is not None:
            return default_value
        try:
            return float(user_input)
        except ValueError:
            print("Invalid input. Please enter a number.")

def get_int_input(prompt):
    while True:
        user_input = input(prompt).strip()
        try:
            return int(user_input)
        except ValueError:
            print("Invalid input. Please enter an integer.")

def get_yes_no_input(prompt):
    while True:
        user_input = input(prompt).strip().lower()
        if user_input in ['y', 'yes']:
            return True
        elif user_input in ['n', 'no']:
            return False
        else:
            print("Invalid input. Please enter 'y' or 'n'.")

def get_directory_path(prompt):
    while True:
        raw = input(prompt).strip().strip('"')
        if os.path.isdir(raw):
            return raw
        else:
            print(f"Directory not found: {raw}")
            print("Please enter a valid directory.")

def get_file_path_agnostic(folder, basename):
    for ext in ['.xlsx', '.txt']:
        path = os.path.join(folder, basename + ext)
        if os.path.isfile(path):
            return path
    return None

def get_column_letter_input(prompt):
    while True:
        col_letter = input(prompt).strip().upper()
        if len(col_letter) == 1 and col_letter.isalpha():
            return col_letter
        else:
            print("Invalid input. Please enter a single letter (e.g., 'A').")

def extract_number_from_filename(filename):
    try:
        base = os.path.splitext(filename)[0]
        try:
            num = int(float(base))
            return num
        except:
            pass
        if base.endswith('C') or base.endswith('c'):
            num_part = base[:-1]
            try:
                num = int(float(num_part))
                return num
            except:
                pass
        import re
        match = re.match(r'(\d+)', base)
        if match:
            return int(match.group(1))
        return None
    except Exception:
        return None

def parse_parameter_columns(im_type, df_im):
    params = []
    if im_type in ['Cordova', 'INp']:
        for col in df_im.columns:
            if col.startswith(f'{im_type}_c'):
                parts = col.split('_')
                c_part = parts[1]
                a_part = parts[2]
                c_val = float(c_part[1:])
                alpha_val = float(a_part[1:])
                label = f"{im_type} (c={c_val:.1f}, α={alpha_val:.2f})"
                params.append((c_val, alpha_val, col, label))
    elif im_type == 'ISa':
        for col in df_im.columns:
            if col.startswith('ISa_a'):
                parts = col.split('_')
                a_part = parts[1]
                b_part = parts[2]
                alpha_val = float(a_part[1:])
                beta_val = float(b_part[1:])
                label = f"ISa (α={alpha_val:.2f}, β={beta_val:.2f})"
                params.append((alpha_val, beta_val, col, label))
    elif im_type == 'AvgSa':
        for col in df_im.columns:
            if col.startswith('AvgSa_a'):
                parts = col.split('_')
                a_part = parts[1]
                b_part = parts[2]
                a_val = float(a_part[1:])
                b_val = float(b_part[1:])
                label = f"Avg Sa (a={a_val:.2f}, b={b_val:.2f})"
                params.append((a_val, b_val, col, label))
    return params

def select_ims_interactive(main_folder, num_walls):
    im_types = ['Cordova', 'INp', 'ISa', 'AvgSa']
    selected = []
    filename_map = {'Cordova': 'Cordova', 'INp': 'INp', 'ISa': 'ISa', 'AvgSa': 'Avg_Sa'}
    first_wall = f"Z1"
    for im in im_types:
        print(f"\n--- Selecting parameter combination for {im} ---")
        actual_filename = filename_map.get(im, im)
        im_file = get_file_path_agnostic(os.path.join(main_folder, first_wall), actual_filename)
        if im_file is None:
            print(f"  {actual_filename} file not found for {first_wall}. Skipping {im}.")
            continue
        if im_file.endswith('.xlsx'):
            df_im = pd.read_excel(im_file)
        else:
            df_im = pd.read_csv(im_file, delimiter=r'\s+')
        params = parse_parameter_columns(im, df_im)
        if not params:
            print(f"  No parameter columns found for {im}. Skipping.")
            continue
        print(f"  Available combinations:")
        for i, (p1, p2, col, label) in enumerate(params, 1):
            print(f"    {i}. {label}")
        choice = get_int_input(f"Select combination (1-{len(params)}): ")
        if 1 <= choice <= len(params):
            selected.append((im, params[choice-1][2], params[choice-1][3]))
        else:
            print("  Invalid choice. Skipping this IM.")
    return selected

