# Data filtering and regression
# ----------------------------------------------------------------------
def filter_data_for_power_law(X, Y, drift_limit_percent):
    valid_mask = (X > 0) & (Y > 0) & (~np.isnan(X)) & (~np.isnan(Y))
    if drift_limit_percent is not None:
        valid_mask = valid_mask & (Y <= drift_limit_percent)
    return X[valid_mask], Y[valid_mask]

def fit_power_law_with_stats(X, Y):
    mask = (X > 0) & (Y > 0)
    X = X[mask]
    Y = Y[mask]
    n = len(X)
    if n < 2:
        return (None,) * 18

    log_X = np.log(X)
    log_Y = np.log(Y)

    model = LinearRegression()
    model.fit(log_X.reshape(-1, 1), log_Y)
    b = model.coef_[0]
    ln_a = model.intercept_
    a = np.exp(ln_a)

    log_Y_pred = model.predict(log_X.reshape(-1, 1))
    Y_pred_orig = a * (X ** b)

    r2_log = model.score(log_X.reshape(-1, 1), log_Y)
    r2_orig = r2_score(Y, Y_pred_orig)

    residuals_log = log_Y - log_Y_pred
    SSE_log = np.sum(residuals_log ** 2)
    sigma = np.sqrt(SSE_log / (n - 2))

    X_bar = np.mean(log_X)
    Sxx = np.sum((log_X - X_bar) ** 2)
    se_b = sigma / np.sqrt(Sxx)
    se_ln_a = sigma * np.sqrt(1.0/n + (X_bar**2)/Sxx)

    t_b0 = b / se_b
    t_b1 = (b - 1) / se_b
    df = n - 2
    p_b0 = 2 * stats.t.sf(abs(t_b0), df)
    p_b1 = 2 * stats.t.sf(abs(t_b1), df)

    alpha = 0.05
    t_crit = stats.t.ppf(1 - alpha/2, df)
    ci_b = (b - t_crit * se_b, b + t_crit * se_b)
    ci_ln_a = (ln_a - t_crit * se_ln_a, ln_a + t_crit * se_ln_a)
    ci_a = (np.exp(ci_ln_a[0]), np.exp(ci_ln_a[1]))
    factor = np.exp(sigma)

    return (a, b, r2_log, r2_orig, sigma, factor,
            se_b, se_ln_a, ci_b, ci_a,
            t_b0, t_b1, p_b0, p_b1,
            residuals_log, Y_pred_orig, n, df)

def interpret_exponent(b):
    if abs(b - 1.0) < 0.1:
        return "approximately linear response"
    elif b > 1.1:
        return "super-linear response (b > 1)"
    elif b < 0.9:
        return "sub-linear response (b < 1)"
    else:
        return "near-linear response"

