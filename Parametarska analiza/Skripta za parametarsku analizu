                    print("  No parameter columns found. Skipping.")
                    continue
                filename_col = df_im.columns[0]
                df_im['FileNum'] = df_im[filename_col].apply(lambda x: extract_number_from_filename(str(x)))
                df_im = df_im.dropna(subset=['FileNum'])
                disp_map = wall_disp_data[wall_id]
                merged = []
                for _, row in df_im.iterrows():
                    fn = row['FileNum']
                    if fn in disp_map:
                        merged.append({'FileNum': fn, **row.to_dict()})
                if not merged:
                    print("  No matching records after merge. Skipping.")
                    continue
                merged = pd.DataFrame(merged)
                merged['Drift'] = merged['FileNum'].map(disp_map)
                wall_results = []
                for (p1, p2, col, label) in params:
                    X_full = merged[col].values
                    Y_full = merged['Drift'].values
                    Xf, Yf = filter_data_for_power_law(X_full, Y_full, drift_limit)
                    n_used = len(Xf)
                    n_total = len(X_full)
                    if n_used < 2:
                        wall_results.append({
                            'wall': display_name, 'p1': p1, 'p2': p2,
                            'r2_log': np.nan, 'sigma': np.nan,
                            'n_used': n_used, 'n_total': n_total
                        })
                        continue
                    res = fit_power_law_with_stats(Xf, Yf)
                    if res[0] is None:
                        wall_results.append({
                            'wall': display_name, 'p1': p1, 'p2': p2,
                            'r2_log': np.nan, 'sigma': np.nan,
                            'n_used': n_used, 'n_total': n_total
                        })
                        continue
                    a_fit, b_fit, r2_log, r2_orig, sigma, factor, _, _, _, _, _, _, _, _, _, _, _, n = res
                    wall_results.append({
                        'wall': display_name, 'p1': p1, 'p2': p2,
                        'r2_log': r2_log, 'sigma': sigma,
                        'n_used': n_used, 'n_total': n_total
                    })

                    if DEBUG:
                        logY = np.log(Yf)
                        logX = np.log(Xf)
                        logY_pred = np.log(a_fit) + b_fit * logX
                        residuals = logY - logY_pred
                        SSE = np.sum(residuals**2)
                        SST = np.sum((logY - np.mean(logY))**2)
                        manual_r2 = 1 - SSE/SST
                        manual_sigma = np.sqrt(SSE / (len(Xf)-2))
                        print(f"\nDEBUG {display_name} {label}:")
                        print(f"  n = {len(Xf)}")
                        print(f"  R²_log = {r2_log:.6f} (manual: {manual_r2:.6f})")
                        print(f"  sigma  = {sigma:.6f} (manual: {manual_sigma:.6f})")
                        print(f"  SSE = {SSE:.6f}, SST = {SST:.6f}")
                        if abs(r2_log - manual_r2) > 1e-6 or abs(sigma - manual_sigma) > 1e-6:
                            print("  WARNING: inconsistency between reported and manually computed values!")
                        else:
                            print("  Values are consistent with manual calculation.")

                df_wall = pd.DataFrame(wall_results)
                all_results.append(df_wall)
                create_sweep_heatmaps(df_wall, display_name, sweep_im, out_dir)
                print(f"  Heatmaps saved for {display_name}")

            if all_results:
                df_all = pd.concat(all_results, ignore_index=True)
                csv_path = os.path.join(out_dir, f"regression_summary_{sweep_im}_sweep.csv")
                df_all.to_csv(csv_path, index=False)
                print(f"\nCombined CSV summary saved: {csv_path}")
            else:
                print(f"\nNo results generated for {sweep_im}.")

    print(f"\nAll results saved to: {out_dir}")
    print("Analysis complete.")

if __name__ == "__main__":
