    # ---- Wall display names ----
    display_name_map = {'Z1': 'Zid 6', 'Z2': 'Zid 8', 'Z3': 'Zid 10', 'Z4': 'Zid 12', 'Z5': 'Zid 14'}
    all_wall_ids = [f"Z{i}" for i in range(1, num_walls+1)]
    wall_display = {wid: display_name_map.get(wid, wid) for wid in all_wall_ids}
    all_display_names = [wall_display[wid] for wid in all_wall_ids]

    # ---- Read displacement data per wall ----
    wall_disp_data = {}
    for wall_id in all_wall_ids:
        print(f"\n=== Processing displacement for {wall_id} ===")
        disp_col_letter = wall_columns.get(wall_id)
        if not disp_col_letter:
            print(f"  No column letter for {wall_id}. Skipping.")
            continue
        col_idx = ord(disp_col_letter) - ord('A')
        disp_path = get_file_path_agnostic(disp_folder, wall_id)
        if disp_path is None:
            print(f"  Displacement file not found for {wall_id}. Skipping.")
            continue
        disp_df = pd.read_excel(disp_path, header=None)
        if disp_df.shape[1] <= col_idx:
            print(f"  Column {disp_col_letter} not found. Skipping.")
            continue
        file_names = disp_df.iloc[:, 0].astype(str).values
        drift_raw = disp_df.iloc[:, col_idx].values
        drift = pd.to_numeric(drift_raw, errors='coerce')
        file_nums = [extract_number_from_filename(fn) for fn in file_names]
        df_disp = pd.DataFrame({'FileNum': file_nums, 'Drift': drift})
        df_disp = df_disp.dropna(subset=['FileNum', 'Drift'])
        if y_type == 1:
            df_disp['Drift'] = df_disp['Drift'] / height * 100.0
        elif y_type == 3:
            wall_h = wall_heights.get(wall_id)
            if wall_h is None or wall_h <= 0:
                print(f"  WARNING: No valid height for {wall_id}. Using 1.0 m.")
                wall_h = 1.0
            df_disp['Drift'] = df_disp['Drift'] / wall_h * 100.0
        else:  # y_type == 2
            df_disp['Drift'] = df_disp['Drift'] * 100.0
        wall_disp_data[wall_id] = dict(zip(df_disp['FileNum'], df_disp['Drift']))
        print(f"  Loaded {len(df_disp)} records for {wall_id}.")

    # ---- Mode-specific processing ----
    if config['mode'] == 'selective':
        selected_ims = config['selected_ims']
        walls_data = {dn: {} for dn in all_display_names}
        summary_rows = []
        wall_markers = {}
        wall_line_styles = {}
        for idx, wall_id in enumerate(all_wall_ids):
            display_name = wall_display[wall_id]
            wall_markers[display_name] = MARKERS[idx % len(MARKERS)]
            wall_line_styles[display_name] = LINE_STYLES[idx % len(LINE_STYLES)]
        print("\n" + "="*70)
        print("SELECTIVE MODE: Processing selected IM combinations")
        print("="*70)

        filename_map = {'Cordova': 'Cordova', 'INp': 'INp', 'ISa': 'ISa', 'AvgSa': 'Avg_Sa'}

        for im_type, col_name, im_label in selected_ims:
            print(f"\n--- Processing {im_label} ---")
            actual_filename = filename_map.get(im_type, im_type)
            for wall_id in all_wall_ids:
                display_name = wall_display[wall_id]
                print(f"  Wall: {display_name} (ID: {wall_id})")
                if wall_id not in wall_disp_data:
                    print("    No displacement data. Skipping.")
                    continue
                im_file = get_file_path_agnostic(os.path.join(main_folder, wall_id), actual_filename)
                if im_file is None:
                    base_path = os.path.join(main_folder, wall_id, actual_filename)
                    print(f"    IM file not found for {wall_id}. Searched:")
                    print(f"      {base_path}.xlsx")
                    print(f"      {base_path}.txt")
                    continue
                if im_file.endswith('.xlsx'):
                    df_im = pd.read_excel(im_file)
                else:
                    df_im = pd.read_csv(im_file, delimiter=r'\s+')
                if col_name not in df_im.columns:
                    print(f"    Column {col_name} not found. Skipping.")
                    continue
                filename_col = df_im.columns[0]
                df_im['FileNum'] = df_im[filename_col].apply(lambda x: extract_number_from_filename(str(x)))
                df_im = df_im.dropna(subset=['FileNum'])
                disp_map = wall_disp_data[wall_id]
                merged = []
                for _, row in df_im.iterrows():
                    fn = row['FileNum']
                    if fn in disp_map:
                        merged.append({'FileNum': fn, 'IM': row[col_name]})
                if not merged:
                    print("    No matching records after merge. Skipping.")
                    continue
                merged = pd.DataFrame(merged)
                merged['Drift'] = merged['FileNum'].map(disp_map)
                X_full = merged['IM'].values
                Y_full = merged['Drift'].values
                Xf, Yf = filter_data_for_power_law(X_full, Y_full, drift_limit)
                n_used = len(Xf)
                n_total = len(X_full)
                if n_used < 2:
                    print(f"    Insufficient data ({n_used}/{n_total}) after filtering. Skipping.")
                    continue
                res = fit_power_law_with_stats(Xf, Yf)
                if res[0] is None:
                    continue
                (a_fit, b_fit, r2_log, r2_orig, sigma, factor,
                 se_b, se_ln_a, ci_b, ci_a,
                 t_b0, t_b1, p_b0, p_b1,
                 residuals_log, Y_pred_orig, n, df) = res
                fitted_log = np.log(a_fit) + b_fit * np.log(Xf)
                summary_rows.append({
                    'Wall': display_name,
                    'IM': im_label,
                    'a': a_fit, 'b': b_fit,
                    'R2_log': r2_log, 'R2_orig': r2_orig,
                    'sigma': sigma, 'factor': factor,
                    'se_b': se_b, 'se_lna': se_ln_a,
                    'ci_b_lower': ci_b[0], 'ci_b_upper': ci_b[1],
                    'ci_a_lower': ci_a[0], 'ci_a_upper': ci_a[1],
                    'p_b0': p_b0, 'p_b1': p_b1,
                    'n_used': n_used, 'n_total': n_total
                })
                walls_data[display_name][im_label] = {
                    'X_filtered': Xf, 'Y_filtered': Yf,
                    'a': a_fit, 'b': b_fit,
                    'r2_log': r2_log, 'r2_orig': r2_orig,
