    reference_drift_limit = config['reference_drift_limit']
    floor_height = config.get('floor_height', 1.0)
    disp_folder = config['displacement_folder']
    im_folder = config['im_folder']
    walls_config = config['walls']  # list of {name, y_col, file_index}

    if y_type == 1:
        y_type_label = 'Drift Ratio (max displacement / floor height)'
    elif y_type == 2:
        y_type_label = 'Average Relative Displacement'
    else:
        y_type_label = 'Drift Ratio (last floor displacement / wall height)'

    stats_file = open(os.path.join(output_dir, "regression_statistics.txt"), "w")
    stats_file.write("Wall Power Law Regression Analysis with Full Statistics\n")
    stats_file.write("="*80 + "\n")
    stats_file.write(f"Analysis performed on: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")
    stats_file.write("Model: Y = a × X^b (Power Law Regression)\n")
    stats_file.write(f"Maximum drift included: {drift_limit}%\n")
    stats_file.write(f"Reference drift limit line: {reference_drift_limit}%\n")
    stats_file.write("="*80 + "\n\n")

    formulas_file = open(os.path.join(output_dir, "regression_formulas_table.txt"), "w")
    formulas_file.write("Power Law Regression Formulas and Statistics Table\n")
    formulas_file.write("="*100 + "\n")
    formulas_file.write(f"Analysis performed on: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")
    formulas_file.write("Model: Y = a × X^b\n")
    formulas_file.write(f"Maximum drift included: {drift_limit}%\n")
    formulas_file.write("="*100 + "\n")
    formulas_file.write("Wall | Intensity | a | b | R²_log | R²_orig | σ | e^σ | SE(b) | SE(lna) | 95% CI b | 95% CI a | t(b=0) | p(b=0) | t(b=1) | p(b=1) | Points used/total | Interpretation\n")
    formulas_file.write("-"*150 + "\n")

    all_headers_set = set()
    all_wall_names = []
    wall_markers = {}
    wall_line_styles = {}
    walls_data = {}

    total_data_points = 0
    total_removed_points = 0
    total_exceed_drift_points = 0

    # Process each wall
    for idx, wall_info in enumerate(walls_config):
        wall_name = wall_info['name']
        file_index = wall_info['file_index']
        y_col = wall_info['y_col']
        all_wall_names.append(wall_name)
        wall_markers[wall_name] = MARKERS[idx % len(MARKERS)]
        wall_line_styles[wall_name] = LINE_STYLES[idx % len(LINE_STYLES)]
        walls_data[wall_name] = {}

        # Locate files
        disp_path = get_file_extension_agnostic_path(disp_folder, f"Z{file_index}")
        im_path = get_file_extension_agnostic_path(im_folder, f"Z{file_index}")
        if disp_path is None:
            print(f"ERROR: Displacement file for Z{file_index} not found in {disp_folder}. Skipping wall {wall_name}.")
            stats_file.write(f"\nWALL: {wall_name} - SKIPPED (displacement file missing)\n")
            continue
        if im_path is None:
            print(f"ERROR: IM file for Z{file_index} not found in {im_folder}. Skipping wall {wall_name}.")
            stats_file.write(f"\nWALL: {wall_name} - SKIPPED (IM file missing)\n")
            continue

        print(f"\nProcessing {wall_name} (files: {os.path.basename(disp_path)}, {os.path.basename(im_path)})")
        stats_file.write(f"\nWALL: {wall_name}\n")
        stats_file.write("-"*60 + "\n")

        # Read displacement
        y_col_index = ord(y_col) - ord('A')
        y_df = pd.read_excel(disp_path, header=None, skiprows=1, usecols=[y_col_index])
        displacement_data = y_df.iloc[:, 0].astype(float).values
        if y_type == 1 or y_type == 3:
            y_data_full = displacement_data / floor_height
        else:
            y_data_full = displacement_data

        # Read intensity measures (hardcoded columns B-M, same as original)
        x_df = pd.read_excel(im_path, usecols=range(1, 13))
        x_headers = x_df.columns.tolist()
        all_headers_set.update(x_headers)

        for j, header in enumerate(x_headers):
            x_data_full = x_df[header].astype(float).values
            X_filtered, Y_filtered, warning_msg, removed_stats, total_count = filter_data_for_power_law(
                x_data_full, y_data_full, wall_name, header, drift_limit_ratio
            )
            total_data_points += total_count
            total_removed_points += removed_stats['removed_total']
            total_exceed_drift_points += removed_stats['removed_exceed_drift']

            if warning_msg:
                print(warning_msg)
                stats_file.write(warning_msg + "\n")

            if len(X_filtered) < 2:
                print(f" Not enough valid data for {header} (need at least 2 points)")
                stats_file.write(f"{header}: Not enough valid data points after filtering (need at least 2)\n\n")
                continue

            res = fit_power_law_with_stats(X_filtered, Y_filtered)
            if res[0] is None:
                print(f" Could not fit power law for {header}")
                stats_file.write(f"{header}: Could not fit power law model\n\n")
                continue

            (a, b, r2_log, r2_orig, sigma, factor,
             se_b, se_lna, ci_b, ci_a,
             t_b0, t_b1, p_b0, p_b1,
             residuals_log, Y_pred_orig, n, df) = res

            walls_data[wall_name][header] = {
                'X_filtered': X_filtered,
                'Y_filtered': Y_filtered,
                'a': a, 'b': b, 'r2_log': r2_log, 'r2_orig': r2_orig,
                'sigma': sigma, 'factor': factor,
                'n_used': n, 'n_total': total_count,
                'se_b': se_b, 'se_lna': se_lna, 'ci_b': ci_b, 'ci_a': ci_a,
                't_b0': t_b0, 't_b1': t_b1, 'p_b0': p_b0, 'p_b1': p_b1
            }

            stats_file.write(f"{header}:\n")
            stats_file.write(f"  Data: {n} of {total_count} points used (removed {total_count - n})\n")
            stats_file.write(f"  a = {a:.6f}, b = {b:.6f}\n")
            stats_file.write(f"  R²_log = {r2_log:.4f}, R²_orig = {r2_orig:.4f}\n")
            stats_file.write(f"  Dispersion σ = {sigma:.4f}, multiplicative factor e^σ = {factor:.4f}\n")
            stats_file.write(f"  SE(b) = {se_b:.6f}, SE(ln a) = {se_lna:.6f}\n")
            stats_file.write(f"  95% CI for b: [{ci_b[0]:.4f}, {ci_b[1]:.4f}]\n")
            stats_file.write(f"  95% CI for a: [{ci_a[0]:.4f}, {ci_a[1]:.4f}]\n")
            stats_file.write(f"  t(b=0) = {t_b0:.4f}, p(b=0) = {p_b0:.4e}\n")
            stats_file.write(f"  t(b=1) = {t_b1:.4f}, p(b=1) = {p_b1:.4e}\n")
            stats_file.write(f"  Exponent interpretation: {interpret_exponent(b)}\n\n")

            formulas_file.write(
                f"{wall_name} | {header} | {a:.6f} | {b:.6f} | {r2_log:.4f} | {r2_orig:.4f} | "
                f"{sigma:.4f} | {factor:.4f} | {se_b:.6f} | {se_lna:.6f} | "
                f"[{ci_b[0]:.4f},{ci_b[1]:.4f}] | [{ci_a[0]:.4f},{ci_a[1]:.4f}] | "
                f"{t_b0:.4f} | {p_b0:.4e} | {t_b1:.4f} | {p_b1:.4e} | "
                f"{n}/{total_count} | {interpret_exponent(b)}\n"
            )

            create_individual_plot(
                wall_name, header, X_filtered, Y_filtered, a, b,
                r2_log, r2_orig, sigma,
                total_count, n, drift_limit_ratio, reference_drift_limit,
                use_log_x, use_log_y, wall_markers[wall_name], output_dir
            )
            print(f" ✓ {header}: R²_log={r2_log:.3f}, σ={sigma:.3f}, {n}/{total_count} points")

    # Summary
    stats_file.write("\n" + "="*60 + "\n")
    stats_file.write("OVERALL FILTERING SUMMARY\n")
    stats_file.write("="*60 + "\n")
    stats_file.write(f"Total data points analyzed: {total_data_points}\n")
    stats_file.write(f"Points removed (all reasons): {total_removed_points} ({total_removed_points/total_data_points*100:.1f}%)\n")
    stats_file.write(f"Points exceeding drift limit: {total_exceed_drift_points} ({total_exceed_drift_points/total_data_points*100:.1f}%)\n")
    stats_file.write(f"Points used for regression: {total_data_points - total_removed_points}\n")
    stats_file.write("\nNote: Filtering criteria: power law requires X>0 and Y>0; Y > drift limit excluded; NaNs excluded.\n")

    stats_file.close()
    formulas_file.close()

    # Heatmaps and comparative plots
    print("\nGenerating additional visualizations...")
    all_headers = sorted(list(all_headers_set))
    n_ims = len(all_headers)
    n_walls = len(all_wall_names)
    r2_matrix = np.full((n_ims, n_walls), np.nan)
    sigma_matrix = np.full((n_ims, n_walls), np.nan)

    for i, header in enumerate(all_headers):
        for j, wall_name in enumerate(all_wall_names):
            if wall_name in walls_data and header in walls_data[wall_name]:
                r2_matrix[i, j] = walls_data[wall_name][header]['r2_log']
                sigma_matrix[i, j] = walls_data[wall_name][header]['sigma']

    create_heatmap(r2_matrix, all_headers, all_wall_names,
                   title='R² (log space) - Power Law Fit',
                   filename=os.path.join(output_dir, 'R2_log_heatmap.png'),
                   vmin=0, vmax=1, cmap='RdYlGn', annot=True, fmt='.3f')

    sigma_vals = sigma_matrix[~np.isnan(sigma_matrix)]
    if len(sigma_vals) > 0:
        vmin_sigma = np.min(sigma_vals)
        vmax_sigma = np.max(sigma_vals)
        if vmin_sigma == vmax_sigma:
            vmin_sigma = vmin_sigma * 0.9
            vmax_sigma = vmax_sigma * 1.1
    else:
        vmin_sigma, vmax_sigma = 0, 1
    create_heatmap(sigma_matrix, all_headers, all_wall_names,
                   title=f'Dispersion σ (green=low, red=high)',
                   filename=os.path.join(output_dir, 'sigma_heatmap.png'),
                   vmin=vmin_sigma, vmax=vmax_sigma, cmap='RdYlGn_r', annot=True, fmt='.3f')

    print("Creating comparative plots per intensity measure...")
    for header in all_headers:
        create_comparative_plot(header, walls_data, all_wall_names, wall_markers, wall_line_styles,
                                use_log_x, use_log_y, drift_limit_ratio, reference_drift_limit,
                                y_type_label, output_dir)
    print("  Comparative plots saved.")

    print(f"\nAll results saved to: {output_dir}")
    print("Analysis complete.")

if __name__ == "__main__":
    main()
