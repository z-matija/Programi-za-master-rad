def save_config(config):
    config_path = get_config_path()
    # Remove large data like full file lists, keep only essential settings
    save_copy = {
        'y_type': config['y_type'],
        'use_log_y': config['use_log_y'],
        'use_log_x': config['use_log_x'],
        'drift_limit': config['drift_limit'],
        'reference_drift_limit': config['reference_drift_limit'],
        'num_walls': config['num_walls'],
        'floor_height': config.get('floor_height'),
        'displacement_folder': config.get('displacement_folder'),
        'im_folder': config.get('im_folder'),
        'walls': []  # only names and column letters
    }
    for w in config['walls']:
        save_copy['walls'].append({
            'name': w['name'],
            'y_col': w['y_col'],
            'file_index': w['file_index']
        })
    with open(config_path, 'w') as f:
        json.dump(save_copy, f, indent=2)
    print(f"Configuration saved to {config_path}")

def load_config():
    config_path = get_config_path()
    if not os.path.exists(config_path):
        return None
    try:
        with open(config_path, 'r') as f:
            saved = json.load(f)
        required = ['y_type', 'use_log_y', 'use_log_x', 'drift_limit',
                    'reference_drift_limit', 'num_walls', 'walls']
        if all(k in saved for k in required):
            return saved
        else:
            print("Config file missing required fields. Ignoring.")
            return None
    except Exception as e:
        print(f"Error loading config: {e}. Ignoring.")
        return None

