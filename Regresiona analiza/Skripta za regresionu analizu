def get_config_dir():
    """Return the directory where the config file should be stored."""
    try:
        return os.path.dirname(os.path.abspath(__file__))
    except NameError:
        return os.getcwd()

def get_config_path():
    return os.path.join(get_config_dir(), CONFIG_FILENAME)

