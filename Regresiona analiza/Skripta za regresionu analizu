def create_individual_plot(wall_name, header, X_valid, Y_valid, a, b, r2_log, r2_orig, sigma,
                           total_count, filtered_count, drift_limit_ratio, reference_drift_limit,
                           use_log_x, use_log_y, wall_marker, output_dir):
    plt.figure(figsize=(14, 10))
    plt.scatter(X_valid, Y_valid, marker=wall_marker, color=COLOR, alpha=0.7, s=30,
                label='Data points')
    x_plot = np.linspace(X_valid.min(), X_valid.max(), 300)
    y_plot = a * (x_plot ** b)
    plt.plot(x_plot, y_plot, color=COLOR, linestyle='-', linewidth=1.5,
             label=f'Power law: y = {a:.4f} x^{b:.3f}')
    plt.axhline(y=reference_drift_limit/100, color=COLOR, linestyle=(0, (3,3)), linewidth=2,
                label=f'Reference drift limit ({reference_drift_limit}%)')
    if drift_limit_ratio is not None:
        plt.axhline(y=drift_limit_ratio, color='red', linestyle=(0, (5,2,1,2)), linewidth=2, alpha=0.7,
                    label=f'Analysis drift limit ({drift_limit_ratio*100:.1f}%)')
    if use_log_y:
        plt.yscale('log')
    if use_log_x:
        plt.xscale('log')
    plt.xlabel(header + (' (log scale)' if use_log_x else ''))
    plt.ylabel('Drift ratio' + (' (log scale)' if use_log_y else ''))
    plt.title(f'{wall_name} - {header} (Power law)')
    ann_text = (f'$a = {a:.4f}$, $b = {b:.3f}$\n'
                f'$R^2_{{log}} = {r2_log:.3f}$, $R^2_{{orig}} = {r2_orig:.3f}$\n'
                f'$\\sigma = {sigma:.3f}$, $e^{{\\sigma}} = {np.exp(sigma):.3f}$\n'
                f'Points: {filtered_count}/{total_count}')
    plt.text(0.02, 0.98, ann_text, transform=plt.gca().transAxes,
             fontsize=10, verticalalignment='top',
             bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))
    plt.legend(fontsize=10, loc='best')
    plt.grid(True, alpha=0.3)
    safe_header = "".join(c for c in header if c.isalnum() or c in (' ', '_')).rstrip()
    safe_wall_name = "".join(c for c in wall_name if c.isalnum() or c in (' ', '_')).rstrip()
    scale_suffix = ""
    if use_log_x and use_log_y:
        scale_suffix = "_log_log"
    elif use_log_x:
        scale_suffix = "_log_x"
    elif use_log_y:
        scale_suffix = "_log_y"
    filename = os.path.join(output_dir, f"{safe_wall_name}_{safe_header}_powerlaw{scale_suffix}.png")
    plt.savefig(filename, dpi=300, bbox_inches='tight')
    plt.close()

def create_comparative_plot(header, walls_data, all_wall_names, wall_markers, wall_line_styles,
                            use_log_x, use_log_y, drift_limit_ratio, reference_drift_limit,
                            y_type_label, output_dir):
    plt.figure(figsize=(14, 10))
    plotted = False
    for wall_name in all_wall_names:
        if wall_name not in walls_data or header not in walls_data[wall_name]:
            continue
        wdata = walls_data[wall_name][header]
        X = wdata['X_filtered']
        Y = wdata['Y_filtered']
        a = wdata['a']
        b = wdata['b']
        r2_log = wdata['r2_log']
        n_used = wdata['n_used']
        n_total = wdata['n_total']
        plt.scatter(X, Y, marker=wall_markers[wall_name], color=COLOR, alpha=0.7, s=30,
                    label=f'{wall_name} ({n_used}/{n_total} points)')
        x_plot = np.linspace(X.min(), X.max(), 300)
        y_plot = a * (x_plot ** b)
        plt.plot(x_plot, y_plot, color=COLOR, linestyle=wall_line_styles[wall_name],
                 linewidth=1.5, label=f'{wall_name}: y={a:.3f} x^{b:.3f} (R²_log={r2_log:.3f})')
        plotted = True
    if not plotted:
        return
    plt.axhline(y=reference_drift_limit/100, color=COLOR, linestyle=(0, (3,3)), linewidth=2,
                label=f'Reference drift limit ({reference_drift_limit}%)')
    if drift_limit_ratio is not None:
        plt.axhline(y=drift_limit_ratio, color='red', linestyle=(0, (5,2,1,2)), linewidth=2, alpha=0.7,
                    label=f'Analysis drift limit ({drift_limit_ratio*100:.1f}%)')
    if use_log_y:
        plt.yscale('log')
    if use_log_x:
        plt.xscale('log')
    plt.xlabel(header + (' (log scale)' if use_log_x else ''))
    plt.ylabel(y_type_label + (' (log scale)' if use_log_y else ''))
    plt.title(f'Comparative Analysis: {header} (Power Law)')
    plt.legend(fontsize=9, loc='best')
    plt.grid(True, alpha=0.3)
    safe_header = "".join(c for c in header if c.isalnum() or c in (' ', '_')).rstrip()
    scale_suffix = ""
    if use_log_x and use_log_y:
        scale_suffix = "_log_log"
    elif use_log_x:
        scale_suffix = "_log_x"
    elif use_log_y:
        scale_suffix = "_log_y"
    filename = os.path.join(output_dir, f"comparative_{safe_header}_powerlaw{scale_suffix}.png")
    plt.savefig(filename, dpi=300, bbox_inches='tight')
    plt.close()

def create_heatmap(data_matrix, row_labels, col_labels, title, filename, vmin=None, vmax=None,
                   cmap='RdYlGn', annot=True, fmt='.3f'):
    if data_matrix.size == 0:
        print(f"  Warning: No data for heatmap {title}")
        return
    n_rows, n_cols = data_matrix.shape
    cell_size = 0.8
    fig_width = max(10, n_cols * cell_size + 2)
    fig_height = max(8, n_rows * cell_size + 1.5)
    plt.figure(figsize=(fig_width, fig_height))
    mask = np.isnan(data_matrix)
    ax = sns.heatmap(data_matrix, annot=annot, fmt=fmt, cmap=cmap, mask=mask,
                     vmin=vmin, vmax=vmax, linewidths=2, linecolor='white',
                     square=True, cbar_kws={'label': title, 'shrink': 0.8},
                     annot_kws={'size': 10, 'weight': 'bold', 'color': 'black'})
    ax.set_xlabel('Walls', fontsize=13, fontweight='bold')
    ax.set_ylabel('Intensity Measures', fontsize=13, fontweight='bold')
    ax.set_title(title, fontsize=15, fontweight='bold', pad=20)
    ax.set_xticks(np.arange(len(col_labels)) + 0.5)
    ax.set_xticklabels(col_labels, rotation=45, ha='right', fontsize=10)
    ax.set_yticks(np.arange(len(row_labels)) + 0.5)
    ax.set_yticklabels(row_labels, fontsize=10, rotation=0)
    for _, spine in ax.spines.items():
        spine.set_visible(True)
        spine.set_linewidth(3)
        spine.set_color('white')
    ax.grid(False)
    plt.tight_layout()
    plt.savefig(filename, dpi=300, bbox_inches='tight', facecolor='white')
    plt.close()
    print(f"  Heatmap saved: {filename}")

