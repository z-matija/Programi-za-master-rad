# ----------------------------------------------------------------------
# Data filtering (unchanged)
# ----------------------------------------------------------------------
def filter_data_for_power_law(X, Y, wall_name, intensity_name, drift_limit_ratio=None):
    total_count = len(X)
    zero_x_indices = np.where(X <= 0)[0]
    zero_y_indices = np.where(Y <= 0)[0]
    nan_x_indices = np.where(np.isnan(X))[0]
    nan_y_indices = np.where(np.isnan(Y))[0]

    valid_mask = (X > 0) & (Y > 0) & (~np.isnan(X)) & (~np.isnan(Y))
    if drift_limit_ratio is not None:
        exceed_drift_indices = np.where(Y > drift_limit_ratio)[0]
        valid_mask = valid_mask & (Y <= drift_limit_ratio)
    else:
        exceed_drift_indices = np.array([])

    X_filtered = X[valid_mask]
    Y_filtered = Y[valid_mask]

    removed_stats = {
        'total_original': total_count,
        'total_filtered': len(X_filtered),
        'removed_total': total_count - len(X_filtered),
        'removed_zero_x': len(zero_x_indices),
        'removed_zero_y': len(zero_y_indices),
        'removed_nan_x': len(nan_x_indices),
        'removed_nan_y': len(nan_y_indices),
        'removed_exceed_drift': len(exceed_drift_indices) if drift_limit_ratio is not None else 0,
        'drift_limit_applied': drift_limit_ratio is not None
    }

    warning_msg = ""
    if removed_stats['removed_total'] > 0:
        warning_msg = f"\n WARNING: {removed_stats['removed_total']} of {total_count} data points removed for {intensity_name}:\n"
        if len(zero_x_indices) > 0:
            warning_msg += f" - X ≤ 0: {len(zero_x_indices)} point(s)\n"
        if len(zero_y_indices) > 0:
            warning_msg += f" - Y ≤ 0: {len(zero_y_indices)} point(s)\n"
        if removed_stats['drift_limit_applied'] and len(exceed_drift_indices) > 0:
            warning_msg += f" - Y > {drift_limit_ratio*100:.1f}%: {len(exceed_drift_indices)} point(s)\n"
        if len(nan_x_indices) > 0:
            warning_msg += f" - X is NaN: {len(nan_x_indices)} point(s)\n"
        if len(nan_y_indices) > 0:
            warning_msg += f" - Y is NaN: {len(nan_y_indices)} point(s)\n"
        warning_msg += f" Remaining for regression: {len(X_filtered)} points\n"
    return X_filtered, Y_filtered, warning_msg, removed_stats, total_count

# ----------------------------------------------------------------------
# Power law fitting (unchanged)
# ----------------------------------------------------------------------
def fit_power_law_with_stats(X, Y):
    mask = (X > 0) & (Y > 0)
    X = X[mask]
    Y = Y[mask]
    n = len(X)
    if n < 2:
        return (None,) * 18

    log_X = np.log(X)
    log_Y = np.log(Y)

    model = LinearRegression()
    model.fit(log_X.reshape(-1, 1), log_Y)
    b = model.coef_[0]
    ln_a = model.intercept_
    a = np.exp(ln_a)

    log_Y_pred = model.predict(log_X.reshape(-1, 1))
    Y_pred_orig = a * (X ** b)

    r2_log = model.score(log_X.reshape(-1, 1), log_Y)
    r2_orig = r2_score(Y, Y_pred_orig)

    residuals_log = log_Y - log_Y_pred
    SSE_log = np.sum(residuals_log ** 2)
    sigma = np.sqrt(SSE_log / (n - 2))

    X_bar = np.mean(log_X)
    Sxx = np.sum((log_X - X_bar) ** 2)
    se_b = sigma / np.sqrt(Sxx)
    se_ln_a = sigma * np.sqrt(1.0/n + (X_bar**2)/Sxx)

    t_b0 = b / se_b
    t_b1 = (b - 1) / se_b
    df = n - 2
    p_b0 = 2 * stats.t.sf(abs(t_b0), df)
    p_b1 = 2 * stats.t.sf(abs(t_b1), df)

    alpha = 0.05
    t_crit = stats.t.ppf(1 - alpha/2, df)
    ci_b = (b - t_crit * se_b, b + t_crit * se_b)
    ci_ln_a = (ln_a - t_crit * se_ln_a, ln_a + t_crit * se_ln_a)
    ci_a = (np.exp(ci_ln_a[0]), np.exp(ci_ln_a[1]))
    factor = np.exp(sigma)

    return (a, b, r2_log, r2_orig, sigma, factor,
            se_b, se_ln_a, ci_b, ci_a,
            t_b0, t_b1, p_b0, p_b1,
            residuals_log, Y_pred_orig, n, df)

def interpret_exponent(b):
    if abs(b - 1.0) < 0.1:
        return "approximately linear response"
    elif b > 1.1:
        return "super-linear response (b > 1)"
    elif b < 0.9:
        return "sub-linear response (b < 1)"
    else:
        return "near-linear response"

